# POC D spikes 1-3. Fill in ME, then: set -a; source spike.env; set +a
PROJECT=gks-datalake-poc2-dev
LOCATION=us-central1
ME=you@example.com                       # your Google account, as gcloud shows it (gcloud config get-value account)

SA_READER_A=spike-reader-a@${PROJECT}.iam.gserviceaccount.com   # stands for a tenant A reader
SA_READER_B=spike-reader-b@${PROJECT}.iam.gserviceaccount.com   # stands for a tenant B reader
SA_WRITER=spike-writer@${PROJECT}.iam.gserviceaccount.com       # stands for sa-dwh-writer-dev
SA_MASKED=spike-masked@${PROJECT}.iam.gserviceaccount.com       # stands for sa-pii-probe (masked reader, no tag)
