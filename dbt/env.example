# Local dbt settings. Not committed (.env is in .gitignore).
# dbt does NOT read this file by itself: load it into your shell first (see below).

# GCP project dbt builds into (read by profiles.yml)
GCP_PROJECT=gks-datalake-poc2-dev

# Your personal dataset prefix for --target local  ->  dbt_<DBT_USER>_stg, _prep, _build, _dq
# Change this to your own short name.
DBT_USER=yugensys

# Pull request number for --target ci  ->  dbt_pr_<PR_NUMBER>_*  (CI sets this)
PR_NUMBER=0

# Tell dbt to find profiles.yml in this folder
DBT_PROFILES_DIR=.

# Load it:
#   bash:        set -a; source .env; set +a
#   PowerShell:  Get-Content .env | Where-Object { $_ -match '^\s*[^#\s]' } | ForEach-Object { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }
